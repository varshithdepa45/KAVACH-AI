# KAVACH AI - environment configuration (copy to .env or export before running)

# Operating mode. 'airgapped' (default) blocks all external cloud AI providers.
KAVACH_MODE=airgapped

# SQLite database file (default: backend/kavach.db)
KAVACH_DB=./kavach.db

# Data directories (defaults shown relative to repo root)
# KAVACH_DEMO_DATA=../demo-data
# KAVACH_UPLOADS=../demo-data/uploads
# KAVACH_GENERATED=../generated

# Upload size cap in MB (default 25)
KAVACH_MAX_UPLOAD_MB=25

# Server (used by your run command; uvicorn reads these via CLI flags)
HOST=0.0.0.0
PORT=8000

# Frontend origins allowed by CORS are fixed in code:
#   http://localhost:3000 and http://localhost:3001
