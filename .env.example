# KAVACH AI — environment configuration (copy to .env)
# Every default keeps the system fully on-premise. No cloud AI keys exist.

# ── Sovereignty ────────────────────────────────────────────────────────────
# airgapped  = external model providers & URLs disabled, only local inference.
# connected  = (future) allow local network inference servers on the LAN.
KAVACH_MODE=airgapped

# ── Backend ────────────────────────────────────────────────────────────────
KAVACH_MAX_UPLOAD_MB=25
# Optional path overrides (defaults resolve relative to the repo root):
# KAVACH_DEMO_DATA=./demo-data
# KAVACH_GENERATED=./generated
# KAVACH_DB=./backend/kavach.db

# ── Frontend ───────────────────────────────────────────────────────────────
# Base URL of the optional FastAPI backend. The UI runs standalone on its local
# mock-inference layer if the backend is offline, so the demo never breaks.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── Local inference (future, when replacing MockLocalModelProvider) ──────────
# KAVACH_INFERENCE_PROVIDER=mock        # mock | ollama | vllm
# OLLAMA_BASE_URL=http://localhost:11434
# VLLM_BASE_URL=http://localhost:8001
